{
  "expo": {
    "name": "Rejsepost",
    "slug": "rejsedagbog",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rejsedagbog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.leth.rejsepost",
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "da",
        "CFBundleLocalizations": [
          "da"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.leth.rejsepost",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F1E7",
          "dark": {
            "backgroundColor": "#161412"
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rejsepost bruger dine billeder, så du kan vælge et billede til et indlæg.",
          "cameraPermission": "Rejsepost bruger kameraet, så du kan tage et billede eller optage en video til et indlæg.",
          "microphonePermission": "Rejsepost bruger mikrofonen, når du optager en video til et indlæg."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rejsepost bruger din position, mens appen er åben, til at tilføje sted og vejr til dine indlæg.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": "Rejsepost bruger din præcise position til at finde stedet, hvor billedet blev taget."
        }
      ],
      "./plugins/with-short-cmake-paths.js",
      "@maplibre/maplibre-react-native",
      "expo-video",
      "expo-sharing",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "795b5600-915e-4a92-9588-3d8405361f26"
      }
    },
    "owner": "leth-digital"
  }
}
