# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Reverse proxyens IP/CIDR, fx 10.0.0.2 eller 172.16.0.0/12. Tom = ingen proxy.
# Bruges til at finde klientens IP til rate limiting. true og antal hop afvises.
# @optional @public
TRUST_PROXY=

# --- Billedlagring: Hetzner Object Storage (S3-API, se docs/udviklingsplan.md afsnit 0.1) ---
# Valgfri i udvikling (så bruges lokal disk); i drift svarer upload-routen 503, hvis de mangler.
# Røgtest af værdierne: npm run s3:smoke -w server

# Hetzner-endpoint for bucket'ens placering: https://fsn1.your-objectstorage.com
# (eller nbg1 / hel1). Uden bucket-navnet foran. Står i signerede URL'er ved path-style.
# @optional @public @type=url
S3_ENDPOINT=

# Placeringen, samme som i endpointet: fsn1, nbg1 eller hel1
# @optional @public
S3_REGION=

# Bucket-navn (unikt på tværs af alle Hetzner-kunder), fx rejsepost-dev-xxxx / rejsepost-prod-xxxx
# @optional @public
S3_BUCKET=

# S3-nøgler fra Hetzner Console (Security -> S3 credentials). De gælder for hele projektet.
# Nøgle-ID'et er ikke hemmeligt: det står i alle signerede billed-URL'er (X-Amz-Credential),
# som API'et sender til appen. Som @sensitive ville varlocks lækagetjek blokere de svar (500).
# @optional @public
S3_ACCESS_KEY_ID=

# Den hemmelige del. Forlader aldrig serveren.
# @optional
S3_SECRET_ACCESS_KEY=

# false = virtual-hosted URL'er (<bucket>.fsn1.your-objectstorage.com), som Hetzner understøtter
# @optional @public @type=boolean
S3_FORCE_PATH_STYLE=false

# --- Login med Google og Apple (valgfrit, se docs/udviklingsplan.md afsnit 8.1) ---
# En udbyder er slået til, når alle dens variabler er sat. Ellers svarer serveren 404 på den.
# Klient-ID'erne er ikke hemmelige: de står i login-adressen, som API'et sender til appen.
# Som @sensitive ville varlocks lækagetjek blokere de svar (500).

# OAuth-klient af typen "Web application" i Google Cloud Console.
# Redirect-URI: <BETTER_AUTH_URL>/api/auth/callback/google
# @optional @public
GOOGLE_CLIENT_ID=

# @optional
GOOGLE_CLIENT_SECRET=

# Service ID'et fra Apple Developer (ikke appens bundle-id), fx dev.leth.rejsepost.login.
# Return URL: <BETTER_AUTH_URL>/api/auth/callback/apple (kræver HTTPS, virker ikke på localhost)
# @optional @public
APPLE_CLIENT_ID=

# @optional @public
APPLE_TEAM_ID=

# ID'et på nøglen med "Sign in with Apple".
# @optional @public
APPLE_KEY_ID=

# Indholdet af .p8-filen på én linje med \n som linjeskift.
# @optional
APPLE_PRIVATE_KEY=

# --- REST Countries v5 (landefakta: valuta, sprog, hovedstad) ---
# Kræver nøgle fra https://restcountries.com/sign-up. Uden nøgle vises kun landenavn og flag.
# @optional
REST_COUNTRIES_API_KEY=
