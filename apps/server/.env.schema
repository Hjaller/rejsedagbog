# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Reverse proxyens IP/CIDR, fx 10.0.0.2 eller 172.16.0.0/12. Tom = ingen proxy.
# Bruges til at finde klientens IP til rate limiting. true og antal hop afvises.
# @optional @public
TRUST_PROXY=

# --- Billedlagring: Hetzner Object Storage (S3-API, se docs/udviklingsplan.md afsnit 0.1) ---
# Valgfri i udvikling (så bruges lokal disk); i drift svarer upload-routen 503, hvis de mangler.
# Røgtest af værdierne: npm run s3:smoke -w server

# Hetzner-endpoint for bucket'ens placering: https://fsn1.your-objectstorage.com
# (eller nbg1 / hel1). Uden bucket-navnet foran.
# @optional @type=url
S3_ENDPOINT=

# Placeringen, samme som i endpointet: fsn1, nbg1 eller hel1
# @optional @public
S3_REGION=

# Bucket-navn (unikt på tværs af alle Hetzner-kunder), fx rejsepost-dev-xxxx / rejsepost-prod-xxxx
# @optional @public
S3_BUCKET=

# S3-nøgler fra Hetzner Console (Security -> S3 credentials). De gælder for hele projektet.
# @optional
S3_ACCESS_KEY_ID=

# @optional
S3_SECRET_ACCESS_KEY=

# false = virtual-hosted URL'er (<bucket>.fsn1.your-objectstorage.com), som Hetzner understøtter
# @optional @public @type=boolean
S3_FORCE_PATH_STYLE=false

# --- REST Countries v5 (landefakta: valuta, sprog, hovedstad) ---
# Kræver nøgle fra https://restcountries.com/sign-up. Uden nøgle vises kun landenavn og flag.
# @optional
REST_COUNTRIES_API_KEY=
