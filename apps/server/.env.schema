# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# --- S3-kompatibel billedlagring (ekstern udbyder, se docs/udviklingsplan.md afsnit 0.1) ---
# Valgfri indtil udbyderen er valgt; upload-routen svarer 503, hvis de mangler.

# S3-endpoint, fx https://<account>.r2.cloudflarestorage.com
# @optional @type=url
S3_ENDPOINT=

# Region, fx auto eller eu-central-1
# @optional @public
S3_REGION=

# Bucket-navn, fx rejsepost-dev / rejsepost-prod
# @optional @public
S3_BUCKET=

# @optional
S3_ACCESS_KEY_ID=

# @optional
S3_SECRET_ACCESS_KEY=

# true for path-style URL'er (fx MinIO/Hetzner), false for virtual-hosted
# @optional @public @type=boolean
S3_FORCE_PATH_STYLE=false

# --- REST Countries v5 (landefakta: valuta, sprog, hovedstad) ---
# Kræver nøgle fra https://restcountries.com/sign-up. Uden nøgle vises kun landenavn og flag.
# @optional
REST_COUNTRIES_API_KEY=
